<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SoundBridge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region). -->
        <Grid x:Name="AppTitleBar" Padding="16,0,16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/app.ico" Width="18" Height="18" />
                <TextBlock Text="SoundBridge" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                <TextBlock
                    Text="Bluetooth audio receiver"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Opacity="0.6"
                    VerticalAlignment="Center"
                    Margin="4,1,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="16,4,16,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- Section header -->
                <Grid>
                    <TextBlock Text="Devices" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button
                            Click="OnRefreshClick"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Refresh the device list">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <Button
                            Click="OnPairDeviceClick"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Open Windows Bluetooth settings to pair a new device">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Pair device" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- First-run hint: nothing paired / nothing supports A2DP yet -->
                <InfoBar
                    x:Name="NoDevicesInfoBar"
                    IsOpen="{x:Bind ViewModel.ShowFirstRunHint, Mode=OneWay}"
                    Severity="Informational"
                    Title="No paired audio devices found"
                    Message="Pair your phone with Windows first — SoundBridge lists every paired A2DP device automatically, then press Refresh."
                    IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button Content="Open Bluetooth settings" Click="OnPairDeviceClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Device cards -->
                <ListView
                    ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="IsTabStop" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="38"
                                        Height="38"
                                        CornerRadius="9"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        VerticalAlignment="Center">
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            Glyph="&#xE702;"
                                            FontSize="18"
                                            Foreground="White" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{Binding StatusText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Opacity="0.75" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ToggleButton
                                            IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                            Click="OnFavoriteClick"
                                            ToolTipService.ToolTip="Auto-reconnect this device">
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE735;" FontSize="14" />
                                        </ToggleButton>
                                        <Button
                                            Click="OnDeviceConnectClick"
                                            IsEnabled="{Binding IsNotBusy}"
                                            MinWidth="108"
                                            Content="{Binding ConnectButtonText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Settings -->
                <Expander
                    Header="Settings"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Margin="0,6,0,0">
                    <StackPanel Spacing="14" Margin="4,8,4,8">
                        <ToggleSwitch
                            x:Name="StartWithWindowsToggle"
                            Header="Start SoundBridge when I sign in to Windows"
                            Toggled="OnStartWithWindowsToggled" />
                        <ToggleSwitch
                            x:Name="StartMinimizedToggle"
                            Header="Start minimized to the notification area"
                            Toggled="OnStartMinimizedToggled" />
                        <ToggleSwitch
                            x:Name="AutoReconnectToggle"
                            Header="Automatically reconnect favorite devices"
                            Toggled="OnAutoReconnectToggled" />
                        <Slider
                            x:Name="ReconnectIntervalSlider"
                            Header="Reconnect check interval (seconds)"
                            Minimum="10"
                            Maximum="120"
                            StepFrequency="5"
                            TickFrequency="10"
                            SnapsTo="StepValues"
                            ValueChanged="OnReconnectIntervalChanged" />
                        <TextBlock
                            x:Name="IntervalValueText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.6"
                            Margin="0,-8,0,0" />
                        <ToggleSwitch
                            x:Name="MinimizeToTrayToggle"
                            Header="Closing the window keeps SoundBridge running in the notification area"
                            Toggled="OnMinimizeToTrayToggled" />
                        <ComboBox
                            x:Name="ThemeCombo"
                            Header="Theme"
                            Width="220"
                            HorizontalAlignment="Left"
                            SelectionChanged="OnThemeSelectionChanged">
                            <ComboBoxItem Content="Follow system" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Status footer -->
        <Border
            Grid.Row="2"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
            <Grid>
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Opacity="0.7"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="v0.1.0"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Opacity="0.5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
